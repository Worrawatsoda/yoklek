# ── Backend env (copy เป็น server/.env แล้วใส่ค่าจริง) ──
MONGODB_URI=mongodb+srv://...your-cluster.../yoklek
JWT_SECRET=ใส่อะไรก็ได้ที่เดายาก-เช่น-สุ่มมายาวๆ

# URL ของ frontend (CORS) — ตอน dev คือ Vite local
CLIENT_URL=http://localhost:5173

# ส่งอีเมลผ่าน Brevo (HTTP API — ส่งให้ใครก็ได้)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# อีเมลผู้ส่ง ต้อง verify เป็น sender ใน Brevo ก่อน (verified แล้ว)
EMAIL_FROM=worrawatsoda@gmail.com

# บัญชี test/admin ที่ข้าม 2FA (อีเมล mock รับ OTP ไม่ได้) — คั่นด้วย comma
OTP_BYPASS_EMAILS=admin@yoklek.com

PORT=5000
